{
  "name": "iobroker-sync",
  "version": "0.1.0",
  "description": "CLI to sync ioBroker JavaScript/TypeScript scripts with a local folder",
  "license": "MIT",
  "bin": {
    "iob-sync": "dist/cli.js"
  },
  "main": "dist/cli.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "build:test": "tsc -p tsconfig.test.json",
    "test": "npm run build:test && node --test \"dist-test/test/**/*.test.js\"",
    "test:unit": "npm run build:test && node --test dist-test/test/mapping.test.js dist-test/test/compare.test.js",
    "clean": "rm -rf dist dist-test"
  },
  "dependencies": {
    "chokidar": "^3.6.0",
    "commander": "^12.1.0",
    "diff": "^5.2.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@types/diff": "^5.2.1",
    "@types/node": "^22.10.0",
    "@types/ws": "^8.5.13",
    "typescript": "^5.7.2"
  },
  "files": [
    "dist/",
    "README.md"
  ]
}
